<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>hephaera</ToolCommandName>
    <PackageId>Hephaera</PackageId>
    <Version>0.0.0-development</Version>
    <Authors>TimothyMeadows</Authors>
    <Description>Versioned Hephaera installer launcher with explicit project setup and automatic scaffolding.</Description>
    <RepositoryUrl>https://github.com/TimothyMeadows/Hephaera</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <EnablePackageValidation>true</EnablePackageValidation>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="HephaeraManifestSha256" Value="$(HephaeraManifestSha256)" />
    <AssemblyMetadata Include="HephaeraPackageVersion" Value="$(Version)" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="LICENSE" Pack="true" PackagePath="/" />
    <Content Include="embedded/**/*" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="tools/net10.0/any/embedded/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
