{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hephaera managed host lock",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "repository",
    "revision",
    "tree",
    "tag",
    "manifestSha256",
    "channel",
    "active",
    "releaseManifest"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string"
    },
    "repository": {
      "const": "https://github.com/TimothyMeadows/Hephaera.git"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "tree": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "tag": {
      "type": "string"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "channel": {
      "enum": [
        "npm",
        "nuget"
      ]
    },
    "active": {
      "type": "boolean"
    },
    "releaseManifest": {
      "$ref": "release.schema.json"
    }
  }
}
